OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.3
DATABASE_URL=sqlite:///./app.db

# Required for production deployments. Do not expose the app with defaults.
APP_ENV=development
APP_USERNAME=admin
APP_PASSWORD=change-me-before-publishing

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Keep false for internet-facing deployments unless docs are behind other auth.
PUBLIC_API_DOCS=false

# Auth hardening.
AUTH_TOKEN_TTL_SECONDS=28800
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
